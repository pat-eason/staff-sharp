# Copy to .env. Everything has a working default; pick a model provider in the app under Settings.
# Without one the app still works: closed questions grade exactly and you self-grade written answers.
ANTHROPIC_API_KEY=
APP_SECRET=change-me-to-a-long-random-string
INTERNAL_TOKEN=change-me-too
POSTGRES_PASSWORD=quiz
WEB_PORT=8484
# How many model calls run at once (grading, scenarios, coaching).
LLM_CONCURRENCY=2
TZ=UTC
